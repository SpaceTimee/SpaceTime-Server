{
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "run-s build serve",
    "serve": "wrangler pages dev dist",
    "worker:deploy": "wrangler deploy --config workers/wrangler.toml",
    "worker:dev": "wrangler dev --config workers/wrangler.toml",
    "worker:start": "wrangler dev --config workers/wrangler.toml",
    "worker:cf-typegen": "wrangler types workers/worker-configuration.d.ts --config workers/wrangler.toml",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force && tsc --project functions/tsconfig.json --noEmit && tsc --project workers/tsconfig.json --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write ."
  },
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.9.2",
    "fast-xml-parser": "^5.9.3",
    "feed": "^5.2.1",
    "jiti": "^2.7.0",
    "less": "^4.6.7",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.4",
    "typescript": "~6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-sitemap": "^0.8.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vue-tsc": "^3.3.6",
    "wrangler": "^4.114.0"
  },
  "type": "module"
}
